# Copy to .env and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=
MODEL_PROVIDER=anthropic   # anthropic (default, live conversation) | ollama (offline/dev)
OLLAMA_MODEL=llama3.2:1b
ANTHROPIC_MODEL=claude-sonnet-5

# Embeddings: Ollama-only for now -- the Anthropic API has no embeddings endpoint.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vision/OCR (transcribing scanned/garbled pages during ingestion):
# tesseract = free local OCR (default, needs the tesseract-ocr system binary
# -- see README.md), anthropic = paid API (~$0.03-0.05/page), opt-in for
# pages Tesseract handles poorly (complex diagrams).
VISION_PROVIDER=tesseract
TESSERACT_LANGS=eng+fra
# Only needed if tesseract.exe isn't on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# VISION_PROVIDER=anthropic
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# SQLite metadata DB path.
DATABASE_URL=sqlite+aiosqlite:///./tutor.db

# Vector store: sqlite-vec is the only adapter for now (see technical-design.md's
# "Vector store choice" -- LEANN was considered and rejected).
VECTOR_STORE=sqlite_vec
VECTOR_STORE_PATH=./vector_store.db

# Upload validation: reject a document upload larger than this many MB.
UPLOAD_MAX_SIZE_MB=50

# Grounding guardrail (Phase 3): how many chunks to retrieve per question,
# and the minimum cosine similarity for the best match to count as "covered"
# -- below this, /chat refuses without calling the Model Provider.
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.55

# Voice I/O (Phase 5): ASR is local (faster-whisper) -- lightweight enough
# for this CPU per technical-design.md's hardware assessment. TTS defaults
# to edge-tts on Windows (Piper's wheel support there is inconsistent, and
# the app already needs internet for the Anthropic API); set TTS_PROVIDER=
# piper for fully offline TTS if piper-tts installed on your machine.
ASR_PROVIDER=whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-AriaNeural
PIPER_VOICE=en_US-lessac-medium
PIPER_DATA_DIR=./piper_voices
